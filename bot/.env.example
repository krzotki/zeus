# Copy this file to ".env" and fill it in. Never commit the real .env.

# OPTIONAL — only for the legacy /inspect route. Leave blank to run login-free
# (/kills, which the Zeus uses, needs no Steam account).
# Steam account the bot logs in as (a secondary account is fine; must own CS2).
STEAM_USERNAME=
STEAM_PASSWORD=

# Optional. Only if this account uses the MOBILE AUTHENTICATOR: paste its
# shared_secret here and the bot generates Guard codes automatically.
# Leave blank to type the Steam Guard code by hand on first login.
STEAM_SHARED_SECRET=

# HTTP port the Zeus polls (http://<this-machine-ip>:PORT/kills?steam=...)
# 2137 matches docker-compose.yml.
PORT=2137
