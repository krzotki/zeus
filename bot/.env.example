# Copy this file to ".env" and fill it in. Never commit the real .env.

# Steam account the bot logs in as (a throwaway/secondary account is fine).
# It must own CS2 (free) so it can open a Game Coordinator session.
STEAM_USERNAME=your_bot_account
STEAM_PASSWORD=your_bot_password

# Optional. Only if this account uses the MOBILE AUTHENTICATOR: paste its
# shared_secret here and the bot generates Guard codes automatically.
# Leave blank to type the Steam Guard code by hand on first login.
STEAM_SHARED_SECRET=

# HTTP port the Zeus polls (http://<this-machine-ip>:PORT/inspect?url=...)
PORT=3000
